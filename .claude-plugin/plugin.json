{
  "name": "ida-mcp",
  "version": "20261003.0.1",
  "description": "Official Hex-Rays IDA MCP Server.",
  "mcpServers": {
    "ida": {
      "command": "uv",
      "args": [
        "run",
        "--no-dev",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "ida-mcp",
        "stdio",
        "--agent=claude"
      ],
      "env": {
        "IDA_MCP_ID": "${IDA_MCP_ID:-}",
        "IDA_MCP_IDLE_TIMEOUT": "${IDA_MCP_IDLE_TIMEOUT:-}",
        "IDAUSR": "${IDAUSR:-}",
        "IDA_NEXUS_STATE_DIR": "${IDA_NEXUS_STATE_DIR:-}",
        "IDA_MCP_STATE_DIR": "${IDA_MCP_STATE_DIR:-}",
        "IDA_MCP_INBOX": "${IDA_MCP_INBOX:-}",
        "IDA_MCP_UPLOAD_MAX_BYTES": "${IDA_MCP_UPLOAD_MAX_BYTES:-}",
        "IDA_MCP_TOKEN": "${IDA_MCP_TOKEN:-}",
        "IDA_MCP_PUBLIC_URL": "${IDA_MCP_PUBLIC_URL:-}"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(.*[_:])?ida__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-dev --project ${CLAUDE_PLUGIN_ROOT} ida-mcp hook claude"
          }
        ]
      }
    ]
  }
}
