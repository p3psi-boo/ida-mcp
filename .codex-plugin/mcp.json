{
  "ida": {
    "command": "uv",
    "args": [
      "run",
      "--no-dev",
      "ida-mcp",
      "stdio",
      "--agent=codex"
    ],
    "cwd": ".",
    "env_vars": [
      "IDA_MCP_ID",
      "IDA_MCP_IDLE_TIMEOUT",
      "IDAUSR",
      "IDA_NEXUS_STATE_DIR",
      "IDA_MCP_STATE_DIR",
      "IDA_MCP_INBOX",
      "IDA_MCP_UPLOAD_MAX_BYTES",
      "IDA_MCP_TOKEN",
      "IDA_MCP_PUBLIC_URL",
      "IDA_MCP_WEBDAV_URL",
      "IDA_MCP_WEBDAV_USER",
      "IDA_MCP_WEBDAV_PASSWORD"
    ]
  }
}
