{
  "mcpServers": {
    "ida": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-dev",
        "--project",
        "${PLUGIN_ROOT}",
        "ida-mcp",
        "stdio",
        "--agent=copilot"
      ],
      "env": {
        "IDA_MCP_ID": "${IDA_MCP_ID:-}",
        "IDA_MCP_IDLE_TIMEOUT": "${IDA_MCP_IDLE_TIMEOUT:-}",
        "IDAUSR": "${IDAUSR:-}",
        "IDA_NEXUS_STATE_DIR": "${IDA_NEXUS_STATE_DIR:-}",
        "IDA_MCP_STATE_DIR": "${IDA_MCP_STATE_DIR:-}",
        "IDA_MCP_INBOX": "${IDA_MCP_INBOX:-}",
        "IDA_MCP_UPLOAD_MAX_BYTES": "${IDA_MCP_UPLOAD_MAX_BYTES:-}",
        "IDA_MCP_TOKEN": "${IDA_MCP_TOKEN:-}",
        "IDA_MCP_PUBLIC_URL": "${IDA_MCP_PUBLIC_URL:-}"
      },
      "tools": [
        "*"
      ]
    }
  }
}
